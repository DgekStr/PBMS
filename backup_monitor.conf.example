# Пример конфигурации PBMS. Замените все значения CHANGE_ME.
PBMS_NODES="pve pve2 pve3"
PBMS_BACKUP_DIR="/mnt/pve/backup/dump"
# Постоянный baseline и отчёт об изменениях за запуск
PBMS_PREVIOUS_DATA_FILE="/var/lib/pbms/previous_backup_data.json"
PBMS_CHANGES_FILE="/tmp/backup_changes.json"
PBMS_RECIPIENT="CHANGE_ME@example.com"
PBMS_SENDER="CHANGE_ME@example.com"
PBMS_SMTP_BIN="msmtp"
PBMS_PVESH_TIMEOUT="15"
PBMS_MIN_BACKUP_SIZE_MB="100"
PBMS_MAX_RUNTIME="30"
PBMS_DEBUG_FILE="/var/log/backup_monitor_debug.log"
PBMS_HOSTNAME="Proxmox cluster"

# Входящий Webhook Mattermost. Настоящий URL храните только в /etc/backup_monitor.conf.
PBMS_MATTERMOST_ENABLED="true"
PBMS_MATTERMOST_WEBHOOK_URL="CHANGE_ME"
PBMS_MATTERMOST_ONLY_ON_ERROR="false"
